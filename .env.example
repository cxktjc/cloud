# Copy to .env and edit. Never commit .env.
V9711_DEPLOY_ROOT=/opt/v9711-live
BINANCE_API_KEY=
BINANCE_API_SECRET=

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=orcaterm2024
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=orcaterm2024

V9711_LIVE_TRADE_ENABLED=0
V9711_LIVE_DRY_RUN=1
V9711_LIVE_ACCOUNT_ID=default
V9711_LIVE_HISTORY_BARS=40
V9711_LIVE_3M_STATUS_FILE=/opt/v9711-live/var/klines_3m_status.json
V9711_LIVE_PRICE_FILE=/opt/v9711-live/var/binance_ticker_price/latest.json
V9711_LIVE_STATE_DIR=/opt/v9711-live/var/state
V9711_LIVE_ACCOUNT_STREAM_DIR=/opt/v9711-live/var/binance_account_stream
V9711_LIVE_EXCHANGE_INFO_CACHE_FILE=/opt/v9711-live/var/exchange_info_cache.json
SYMBOLS_FILE=/opt/v9711-live/config/symbols.txt
KLINE_RETENTION_HOURS=24

# WS price coalescing: aggTrade is high-frequency; JSON is published at 10Hz.
TICKER_STREAMS_PER_CONNECTION=200
TICKER_PUBLISH_INTERVAL=0.1
TICKER_HEARTBEAT=5
TICKER_PING_INTERVAL=30
TICKER_PING_TIMEOUT=20
TICKER_READ_TIMEOUT=30
