[Unit]
Description=v9711 3m to 15m aggregator (one-day window)
After=v9711-3m.service
Requires=v9711-3m.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/v9711-live/cloud
EnvironmentFile=/opt/v9711-live/cloud/.env
ExecStart=/opt/v9711-live/cloud/.venv/bin/python -m collectors.kline_aggregator_15m --symbols-file /opt/v9711-live/cloud/config/symbols.txt --retention-hours 24 --startup-check-windows 96 --trigger-file /opt/v9711-live/cloud/var/kline_aggregator_15m.trigger
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
