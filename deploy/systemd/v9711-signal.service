[Unit]
Description=v9711 signal process
After=v9711-ticker.service v9711-3m.service
Requires=v9711-ticker.service v9711-3m.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/v9711-live/cloud
EnvironmentFile=/opt/v9711-live/cloud/.env
ExecStart=/opt/v9711-live/cloud/.venv/bin/python -m v9711_live.run_signal
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
