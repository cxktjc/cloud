# Copy to .env and edit. Never commit .env.
# Ubuntu checkout: /opt/v9711-live/cloud/ws_direct_v2. Adjust paths if deploying elsewhere.
# Runtime paths are fixed relative to code, not configured here.
# --paper selects var/paper_state for BOTH matching processes.

BINANCE_API_KEY=
BINANCE_API_SECRET=

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=orcaterm2024
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=orcaterm2024

V9711_LIVE_TRADE_ENABLED=0
V9711_LIVE_DRY_RUN=1
V9711_LIVE_ACCOUNT_ID=default
V9711_LIVE_HISTORY_BARS=96
KLINE_RETENTION_HOURS=24

# WS price coalescing: aggTrade is high-frequency; JSON is published at 10Hz.
TICKER_STREAMS_PER_CONNECTION=200
TICKER_PUBLISH_INTERVAL=0.1
TICKER_HEARTBEAT=5
TICKER_PING_INTERVAL=30
TICKER_PING_TIMEOUT=20
TICKER_READ_TIMEOUT=30

# Display only: signal calculation and plan publishing remain high-frequency.
V9711_LIVE_SIGNAL_MIN_REFRESH_SECONDS=3

# Trade display only; order handling and polling remain high-frequency.
V9711_LIVE_TRADE_MIN_REFRESH_SECONDS=3

# Price mirror only. Execution never waits for this interval.
V9711_WS_MIRROR_SECONDS=0.1
V9711_WS_MAX_QUEUE_AGE_SECONDS=0.5
V9711_WS_QUEUE_SIZE=8192

# v2 trade close policy is fixed in code: start timed exits 1s early;
# up to 12 QUEUE rounds, 5s after each ACK, then confirmed-cancel MARKET residual.
# Legacy V9711_LIVE_CLOSE_LIMIT_SECONDS is ignored by v2.
# Existing CLOSE_LIMIT_ENABLED=0 still explicitly selects immediate MARKET.

# v2 entry tiers are fixed at 2.0% / 1.8% / 1.6%; old *_PLACE_GAP overrides
# are ignored. History is at least 96 even when an old .env still says 40.
